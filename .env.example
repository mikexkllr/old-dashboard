# Copy to .env for `docker compose` on the host. In Portainer, enter the same
# names as stack environment variables instead.

# Immich supplies the photos. Leave both empty to turn photos off.
# On an Umbrel, use its IP address: http://<umbrel-ip>:2283
IMMICH_URL=http://192.168.1.10:2283
IMMICH_API_KEY=
# The photo filters below are defaults. The settings menu on the iPad can change
# all of them, with album and people lists to tap.
# Comma-separated album IDs. Leave empty to use the whole library.
IMMICH_ALBUM_IDS=
# Comma-separated person IDs. Leave empty for photos of anyone.
IMMICH_PERSON_IDS=
# Only photos taken in these years, for example 2015 and empty for "2015 onwards".
IMMICH_FROM_YEAR=
IMMICH_TO_YEAR=
IMMICH_FAVORITES_ONLY=false
IMMICH_PLAYLIST_SIZE=200

# Home Assistant powers the home panel. Leave both empty to turn it off.
# Use the IP address: containers can't resolve .local names such as homeassistant.local.
HA_URL=http://192.168.1.10:8123
HA_TOKEN=
# Extra entities to show and control, such as scripts, automations, buttons, groups
# or garage, door and gate covers. Leave empty: lights, rooms, covers, switches,
# scenes, climate and sensors are found automatically.
HA_ENTITIES=
# Entities to leave off the panel, for example noisy sensors.
HA_HIDE_ENTITIES=

# Frame behaviour. These are defaults too, which the settings menu can change.
SLIDE_INTERVAL_SECONDS=60
PHOTO_FIT=auto
SHOW_CLOCK=true
SHOW_CAPTIONS=true
PANEL_IDLE_SECONDS=60

# Port on the host that serves the dashboard. Several Umbrel apps use 8080; 8585 is free there.
DASHBOARD_PORT=8080
